#!/bin/bash
# ~/.panopticon/bin/pre-tool-hook
# Called by Claude Code before every tool use (PreToolUse hook)
#
# Emits agent.activity_changed(working) via POST to the Panopticon dashboard.
# Keeps runtime.json fallback during Phase 4→5 transition.

# Don't use set -e - we want the hook to be resilient to failures
# and never break Claude Code execution

# Source shared helpers
source "$(dirname "$0")/hook-lib.sh"

# Resolve agent ID
AGENT_ID="$(_panopticon_resolve_agent_id)"
AGENT_ID="${AGENT_ID:-unknown}"

# Parse tool info from stdin
TOOL_INFO=$(cat 2>/dev/null || echo '{}')

# Check if jq is available
if ! command -v jq &> /dev/null; then
  exit 0  # Silent failure - don't break Claude Code execution
fi

# Extract tool name
TOOL_NAME=$(echo "$TOOL_INFO" | jq -r '.tool_name // "unknown"' 2>/dev/null || echo "unknown")

# ─── PAN-800: Emit typed event ────────────────────────────────────────────────

TIMESTAMP="$(date -Iseconds)"
EVENT_BODY=$(jq -n \
  --arg kind "activity" \
  --arg activity "working" \
  --arg tool "$TOOL_NAME" \
  '{kind: $kind, activity: $activity, tool: $tool}')
panopticon_post_event "$AGENT_ID" "$EVENT_BODY" || true

# ─── Legacy: update runtime.json (transitional fallback) ──────────────────────

STATE_DIR="$HOME/.panopticon/agents/$AGENT_ID"
mkdir -p "$STATE_DIR"

RUNTIME_FILE="$STATE_DIR/runtime.json"
TEMP_FILE="$STATE_DIR/runtime.json.tmp"

if [ -f "$RUNTIME_FILE" ]; then
  jq --arg ts "$TIMESTAMP" --arg tool "$TOOL_NAME" \
    '.lastActivity = $ts | .currentTool = $tool | .state = "active"' \
    "$RUNTIME_FILE" > "$TEMP_FILE" 2>/dev/null && mv "$TEMP_FILE" "$RUNTIME_FILE" 2>/dev/null || true
else
  jq -n \
    --arg timestamp "$TIMESTAMP" \
    --arg state "active" \
    --arg tool "$TOOL_NAME" \
    '{
      state: $state,
      lastActivity: $timestamp,
      currentTool: $tool
    }' > "$TEMP_FILE" 2>/dev/null || true
  mv "$TEMP_FILE" "$RUNTIME_FILE" 2>/dev/null || true
fi

# Always exit successfully
exit 0
